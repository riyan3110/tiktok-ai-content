NODE_ENV=development
PORT=3000
# Penyedia AI: gemini, groq, atau openai
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash-lite
# Opsional: endpoint penyedia daftar tren (respons berupa array atau field topics/data/results)
TRENDING_API_URL=
TRENDING_API_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://example.com/auth/tiktok/callback
PUBLIC_BASE_URL=https://example.com
SESSION_SECRET=ganti-dengan-string-acak-panjang
# Opsional: jadwal pembuatan otomatis (default 09:00 WIB setiap hari)
CRON_SCHEDULE=0 9 * * *
CRON_TIMEZONE=Asia/Jakarta
ENABLE_CRON=false
# Sumber topik cron: manual, ai, atau trending
DAILY_TOPIC_MODE=ai
# Wajib diisi bila DAILY_TOPIC_MODE=manual
DAILY_MANUAL_TOPIC=
# Identitas watermark teks pada slide (tanpa aset gambar)
WATERMARK_ENABLED=true
WATERMARK_TEXT=AI ADS LAB
WATERMARK_OPACITY=0.4
WATERMARK_POSITION=top-left
WATERMARK_FONT_SIZE=28
