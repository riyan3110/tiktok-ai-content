NODE_ENV=development
PORT=3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://example.com/auth/tiktok/callback
PUBLIC_BASE_URL=https://example.com
SESSION_SECRET=ganti-dengan-string-acak-panjang
# Opsional: jadwal pembuatan otomatis (default 09:00 WIB setiap hari)
CRON_SCHEDULE=0 9 * * *
CRON_TIMEZONE=Asia/Jakarta
ENABLE_CRON=false
